# Copy the required values into the hosting .env file, then fill in the secrets there.
APP_NAME="SI-GYM"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_A_NEW_PRODUCTION_KEY
APP_DEBUG=false
APP_URL=https://gymbrebes.free.nf
ASSET_URL=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_HOST_FROM_HOSTING_PANEL
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_DATABASE_USERNAME
DB_PASSWORD="REPLACE_WITH_DATABASE_PASSWORD"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Password reset emails require a working SMTP provider.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=REPLACE_WITH_SMTP_HOST
# MAIL_PORT=587
# MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
# MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# MAIL_FROM_ADDRESS=REPLACE_WITH_VERIFIED_SENDER
# MAIL_FROM_NAME="${APP_NAME}"
